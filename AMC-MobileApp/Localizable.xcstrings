        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything is calculated per household: a small, very engaged borough can beat a big one. We add a few “average” households to each so a tiny group doesn’t shoot ahead on a single month."
          }
        }
      }
    },
