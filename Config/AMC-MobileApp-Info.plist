<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Fusionné avec l'Info.plist généré par Xcode (GENERATE_INFOPLIST_FILE = YES). -->
	<!-- Nom affiché sous l'icône. -->
	<key>CFBundleDisplayName</key>
	<string>LeGrenier</string>
	<!-- Schéma d'URL de retour Google Sign-In = REVERSED_CLIENT_ID de GoogleService-Info.plist. -->
	<!-- Face ID : verrou de l'app et confirmation des paiements (Core/Security). -->
	<key>NSFaceIDUsageDescription</key>
	<string>LeGrenier utilise Face ID pour protéger ton compte et confirmer tes paiements.</string>
	<!-- Cueillette (T-181) : l'hôte scanne le code QR d'une famille pour remettre sa part. -->
	<key>NSCameraUsageDescription</key>
	<string>LeGrenier utilise la caméra pour lire le code QR d'une famille quand tu lui remets sa part. Aucune image n'est enregistrée.</string>
	<!-- Carte des familles (T-091) : position pendant l'utilisation, sinon la carte reste sur le quartier du ménage. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>LeGrenier utilise ta position pendant que la carte est ouverte pour te montrer les groupes, les points de cueillette et les producteurs près de chez toi. Elle n'est jamais partagée avec tes voisins.</string>
	<!-- Live Activity de la commande (cible GrenierWidgets, Core/LiveActivity), démarrée localement. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- App Group partagé avec GrenierWidgets (SharedLanguage), dérivé du bundle ID de la build. -->
	<key>GrenierAppGroup</key>
	<string>group.$(GRENIER_BUNDLE_ID)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google-sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GRENIER_GOOGLE_URL_SCHEME)</string>
			</array>
		</dict>
		<!-- Liens d'invitation à un groupe (B-058) : grenier://join/<code>, routés par InviteLinkRouter. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>ca.amc2026.mobileapp.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>grenier</string>
			</array>
		</dict>
	</array>
	<!-- Rafraîchissement en arrière-plan → notifications locales, sans serveur (T-107, Core/Notifications/BackgroundRefresh). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>ca.amc2026.mobileapp.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
