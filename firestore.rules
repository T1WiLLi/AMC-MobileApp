rules_version = '2';

// ===============================================================
// Règles Firestore de Grenier — prototype de la compétition, à revoir avant diffusion large.
// Tests : scripts/rules-tests (émulateur). Déploiement : docs/firebase.md.
// ===============================================================
//
// Modèle (AMC-MobileApp/Core/Models/, onglet « Requis ») :
//   users/{uid}                          profil ; lu et écrit par son propriétaire seulement
//   households/{id}                      ménage ; lu et écrit par ses membres (userIds)
//   households/{id}/private/profile      isSubsidized, referralCode ; membres du ménage seulement
//   groups/{id}                          groupe de quartier ; lecture par tout utilisateur connecté ;
//                                        seul householdCount bouge, avec l'adhésion (T-099)
//   groups/{id}/members/{householdId}    adhésion ; un ménage s'ajoute ou se retire lui-même
//   vendors/{id}                         vendeur ; lecture connectée, le vendeur modifie sa vitrine
//   vendorReviews/{vendorId}_{household} avis d'une famille (T-157) ; lecture connectée, écrit par le ménage acheteur
//   products/{id}, offers/{id}           catalogue ; lecture connectée, écrit par le vendeur propriétaire
//   groupOrders/{id}                     commande groupée ; lecture connectée, écriture serveur/seed seulement
//   groupOrders/{id}/shares/{householdId} part d'un ménage ; le ménage la crée, change sa quantité, la retire
//   pickupPoints/{id}                    point de cueillette ; lecture connectée, l'hôte gère créneaux et capacité
//
// Points sensibles :
//   - users.vendorId n'est écrit par le client que pour se rattacher SON vendeur (T-158) : vide avant, et le vendeur
//     pointé a ownerId == uid. Sinon n'importe qui deviendrait vendeur d'un autre.
//   - vendors/{id} : un compte crée UN vendeur (id vendor-{uid}), non vérifié, sans note (onboarding T-158).
//   - Dans une part, isPaid, finalPriceCents, subsidyCents, qrCode et isPickedUp ne sont pas modifiables
//     par le client : ils viendront d'un processus de confiance.
//   - Aucune lecture d'un document de PII (users, households, private) par quelqu'un d'extérieur.
//   - Le seed (Admin SDK) contourne ces règles.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helper Functions
    // ---------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isShortString(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    function isIntIn(value, low, high) {
      return value is int && value >= low && value <= high;
    }

    function isStringList(value, maxSize) {
      return value is list && value.size() <= maxSize;
    }

    function isOptionalString(data, field, maxSize) {
      return !(field in data) || data[field] == null || isShortString(data[field], 0, maxSize);
    }

    function myUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Le vendeur rattaché au compte connecté (seed, admin, ou son propre vendeur à l'onboarding T-158).
    function isVendorOf(vendorId) {
      return isAuthenticated()
        && vendorId is string && vendorId.size() > 0
        && exists(myUserPath())
        && get(myUserPath()).data.get('vendorId', '') == vendorId;
    }

    function isMemberOfHousehold(householdId) {
      let path = /databases/$(database)/documents/households/$(householdId);
      return isAuthenticated() && exists(path) && request.auth.uid in get(path).data.userIds;
    }

    // ---------------------------------------------------------------
    // users/{userId}
    // ---------------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasOnly(['id', 'displayName', 'photoURL', 'language', 'roles', 'neighborhood',
                                  'dietaryPreferences', 'seniorMode', 'householdId', 'vendorId',
                                  'photoUpdatedAt', 'favoriteCategories', 'onboardingCompleted'])
        && data.keys().hasAll(['id', 'displayName', 'language', 'roles', 'neighborhood',
                               'dietaryPreferences', 'seniorMode'])
        && isShortString(data.displayName, 1, 80)
        && data.language in ['fr', 'en']
        && isStringList(data.roles, 4)
        && data.roles.toSet().difference(['family', 'vendor', 'host', 'organization'].toSet()).size() == 0
        && isShortString(data.neighborhood, 0, 60)
        && isStringList(data.dietaryPreferences, 20)
        && data.seniorMode is bool
        && isOptionalString(data, 'photoURL', 2048)
        && isOptionalString(data, 'householdId', 128)
        // Avatar en bytes (T-132) : horodatage posé avec l'image, pour invalider le cache des autres appareils.
        && (!('photoUpdatedAt' in data) || data.photoUpdatedAt == null || data.photoUpdatedAt is timestamp)
        // Onboarding après l'inscription (T-156) : catégories aimées (Product.Category) et drapeau « fini ».
        && (!('favoriteCategories' in data) || data.favoriteCategories == null
            || (isStringList(data.favoriteCategories, 9)
                && data.favoriteCategories.toSet().difference(['grains', 'legumes', 'oils', 'flour', 'canned',
                                                               'eggs', 'meat', 'produce', 'household'].toSet()).size() == 0))
        && (!('onboardingCompleted' in data) || data.onboardingCompleted == null || data.onboardingCompleted is bool);
    }

    // Onboarding producteur (T-158) : le compte se rattache le vendeur qu'il vient de créer, une seule fois.
    // getAfter : marche dans un batch (vendeur + profil) comme après la création du vendeur.
    function isClaimingOwnVendor(userId) {
      let vendorId = request.resource.data.get('vendorId', '');
      let vendorPath = /databases/$(database)/documents/vendors/$(vendorId);
      return resource.data.get('vendorId', '') in ['', null]
        && vendorId is string && vendorId.size() > 0 && vendorId.size() <= 128
        && existsAfter(vendorPath)
        && getAfter(vendorPath).data.get('ownerId', '') == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.id == userId
        && !('vendorId' in request.resource.data);
      allow update: if isOwner(userId)
        && isValidUser(request.resource.data)
        && areImmutableFieldsUnchanged(['id'])
        && (areImmutableFieldsUnchanged(['vendorId']) || isClaimingOwnVendor(userId));
      allow delete: if isOwner(userId);
    }

    // ---------------------------------------------------------------
    // households/{householdId} (+ private/profile)
    // ---------------------------------------------------------------

    function isValidHousehold(data) {
      return data.keys().hasOnly(['id', 'name', 'size', 'geohash', 'userIds', 'groupId'])
        && data.keys().hasAll(['id', 'name', 'size', 'geohash', 'userIds'])
        && isShortString(data.name, 1, 80)
        && isIntIn(data.size, 1, 30)
        && isShortString(data.geohash, 0, 12)
        && data.userIds is list && data.userIds.size() >= 1 && data.userIds.size() <= 10
        && isOptionalString(data, 'groupId', 128);
    }

    match /households/{householdId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.userIds;
      allow create: if isAuthenticated()
        && isValidHousehold(request.resource.data)
        && request.resource.data.id == householdId
        && request.auth.uid in request.resource.data.userIds;
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.userIds
        && isValidHousehold(request.resource.data)
        && areImmutableFieldsUnchanged(['id']);
      allow delete: if false;

      match /private/{docId} {
        allow read: if isMemberOfHousehold(householdId);
        allow create, update: if isMemberOfHousehold(householdId)
          && docId == 'profile'
          && request.resource.data.keys().hasOnly(['isSubsidized', 'referralCode'])
          && request.resource.data.isSubsidized is bool
          && isOptionalString(request.resource.data, 'referralCode', 64)
          // Statut subventionné seulement avec un code d'organisme bien formé (ReferralCode, RQ-082).
          && (request.resource.data.isSubsidized == false
              || (request.resource.data.get('referralCode', null) is string
                  && request.resource.data.referralCode.matches('ORG-[A-Z]{2}-[0-9]{4}[0-9X]')));
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // groups/{groupId} (+ members)
    // ---------------------------------------------------------------

    // householdCount (T-099) : il n'y a pas de serveur, donc `join` / `leave` écrivent dans UN
    // batch atomique l'adhésion ET le compteur du groupe :
    //   join  : create members/{h}  +  update groups/{g} { householdCount: +1, lastMembershipChange: h }
    //   leave : delete members/{h}  +  update groups/{g} { householdCount: -1, lastMembershipChange: h }
    // La règle du groupe ne voit pas le document membre écrit à côté : le client nomme donc le
    // ménage concerné dans `lastMembershipChange`. La règle vérifie que ce ménage est à l'appelant
    // (households/{h}.userIds) et que son adhésion apparaît (+1) ou disparaît (-1) dans le même
    // batch (exists / existsAfter). Réciproquement, l'adhésion ne se crée ou ne se supprime que si
    // le compteur bouge de ±1 dans le batch avec ce même ménage : le compteur ne peut pas dériver.
    // Deux ménages qui rejoignent en même temps : Firestore sérialise les batchs, et
    // FieldValue.increment s'applique sur la valeur courante.
    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function memberPath(groupId, householdId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(householdId);
    }

    // Le compteur du groupe change de `delta` dans cette requête, au nom de `householdId`.
    function isCountChangedBy(groupId, householdId, delta) {
      let before = get(groupPath(groupId)).data;
      let after = getAfter(groupPath(groupId)).data;
      return after.get('lastMembershipChange', '') == householdId
        && after.get('householdCount', 0) == before.get('householdCount', 0) + delta;
    }

    // B-056 : un groupe est public (listé) ou privé (jamais listé, sur invitation à usage unique).
    // Champ `isPublic` absent = public. Le créateur (`createdBy`, sinon le premier coordonnateur) seul
    // change la visibilité et gère les invitations (`groupInvitations/{code}`).
    function isPublicGroupData(data) {
      return data.get('isPublic', true) == true;
    }

    function groupCreatorId(data) {
      let coordinators = data.get('coordinatorIds', []);
      return data.get('createdBy', coordinators.size() > 0 ? coordinators[0] : '');
    }

    function isGroupCreator(groupId) {
      return isAuthenticated() && exists(groupPath(groupId))
        && groupCreatorId(get(groupPath(groupId)).data) == request.auth.uid;
    }

    function invitationPath(code) {
      return /databases/$(database)/documents/groupInvitations/$(code);
    }

    // Adhésion à un groupe privé : l'invitation nommée par `invitationCode`, pas encore utilisée ni révoquée,
    // est consommée par ce ménage dans la même requête (transaction FirestoreGroupRepository.consume).
    function isConsumingInvitation(groupId, householdId) {
      let code = request.resource.data.get('invitationCode', '');
      return code is string && code.size() > 0
        && exists(invitationPath(code))
        && get(invitationPath(code)).data.groupId == groupId
        && get(invitationPath(code)).data.get('usedBy', null) == null
        && get(invitationPath(code)).data.get('revokedAt', null) == null
        && getAfter(invitationPath(code)).data.get('usedBy', null) == householdId;
    }

    match /groups/{groupId} {
      allow get: if isAuthenticated();
      // Les groupes privés ne sont jamais listés : une requête doit filtrer `isPublic == true`.
      allow list: if isAuthenticated() && resource.data.isPublic == true;
      allow create: if isGroupCreation();
      allow delete: if false;
      allow update: if isMembershipCountUpdate() || isMediaStampUpdate() || isBrandingUpdate() || isVisibilityUpdate();

      // B-059 : une personne crée un groupe depuis l'app. Elle en est la créatrice et la seule coordonnatrice,
      // son ménage (`lastMembershipChange`) en est le premier membre, coordonnateur, écrit dans le même batch.
      // La limite de 3 groupes par ménage (RQ-030) est vérifiée par l'app : les règles ne comptent pas les adhésions.
      function isGroupCreation() {
        let data = request.resource.data;
        let householdId = data.get('lastMembershipChange', '');
        return isAuthenticated()
          && data.keys().hasOnly(['name', 'neighborhood', 'centerGeohash', 'radiusMeters', 'coordinatorIds',
                                  'householdCount', 'isPublic', 'inviteCode', 'createdBy', 'createdAt',
                                  'lastMembershipChange'])
          && data.keys().hasAll(['name', 'neighborhood', 'centerGeohash', 'radiusMeters', 'coordinatorIds',
                                 'householdCount', 'isPublic', 'inviteCode', 'createdBy', 'createdAt',
                                 'lastMembershipChange'])
          && data.createdBy == request.auth.uid
          && data.coordinatorIds == [request.auth.uid]
          && data.householdCount == 1
          && isShortString(data.name, 3, 40)
          && isShortString(data.neighborhood, 1, 80)
          && data.centerGeohash is string && data.centerGeohash.matches('^[0-9b-hjkmnp-z]{4,12}$')
          && isIntIn(data.radiusMeters, 1000, 2000)
          && data.isPublic is bool
          && data.inviteCode is string && data.inviteCode.matches('^[A-HJ-NP-Z2-9]{6}$')
          && data.createdAt == request.time
          && householdId is string && householdId.size() > 0
          && isMemberOfHousehold(householdId)
          && existsAfter(memberPath(groupId, householdId))
          && getAfter(memberPath(groupId, householdId)).data.role == 'coordinator';
      }

      // B-036 (T-152) : le coordonnateur change la marque du groupe (champ `branding` seulement).
      // Champs absents = valeur par défaut (GroupBranding) ; accents en « #RRGGBB ».
      function isBrandingUpdate() {
        let branding = request.resource.data.branding;
        return isGroupCoordinator(groupId)
          && onlyChanges(['branding'])
          && branding is map
          && branding.keys().hasOnly(['displayName', 'emblem', 'accentLight', 'accentDark', 'welcomeMessage'])
          && isOptionalString(branding, 'displayName', 40)
          && isOptionalString(branding, 'emblem', 64)
          && isOptionalString(branding, 'welcomeMessage', 160)
          && isOptionalHex(branding, 'accentLight')
          && isOptionalHex(branding, 'accentDark');
      }

      function isOptionalHex(data, field) {
        return !(field in data) || data[field] == null
          || (data[field] is string && data[field].matches('^#[0-9A-Fa-f]{6}$'));
      }

      // B-056 : le créateur rend son groupe public ou privé ; rien d'autre ne bouge.
      function isVisibilityUpdate() {
        return isAuthenticated()
          && groupCreatorId(resource.data) == request.auth.uid
          && onlyChanges(['isPublic'])
          && request.resource.data.isPublic is bool;
      }

      // T-132 : le coordonnateur pose photoUpdatedAt / bannerUpdatedAt (= request.time) après avoir écrit
      // groups/{groupId}/media/{photo|banner} ; rien d'autre ne bouge.
      function isMediaStampUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return isGroupCoordinator(groupId)
          && changed.size() > 0
          && changed.hasOnly(['photoUpdatedAt', 'bannerUpdatedAt'])
          && (!('photoUpdatedAt' in changed) || request.resource.data.photoUpdatedAt == request.time)
          && (!('bannerUpdatedAt' in changed) || request.resource.data.bannerUpdatedAt == request.time);
      }

      function isMembershipCountUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        let householdId = after.get('lastMembershipChange', '');
        let delta = after.get('householdCount', 0) - before.get('householdCount', 0);
        let wasMember = exists(memberPath(groupId, householdId));
        let isMember = existsAfter(memberPath(groupId, householdId));
        return onlyChanges(['householdCount', 'lastMembershipChange'])
          && householdId is string && householdId.size() > 0
          && after.householdCount is int && after.householdCount >= 0
          && isMemberOfHousehold(householdId)
          && ((delta == 1 && !wasMember && isMember) || (delta == -1 && wasMember && !isMember));
      }

      match /members/{householdId} {
        allow read: if isAuthenticated();
        allow create: if isMemberOfHousehold(householdId)
          && request.resource.data.householdId == householdId
          && request.resource.data.joinedAt == request.time
          && (isJoining() || isCreatorMembership());

        function isJoining() {
          return exists(groupPath(groupId))
            && request.resource.data.keys().hasOnly(['householdId', 'role', 'joinedAt', 'invitationCode'])
            && request.resource.data.role == 'member'
            && isCountChangedBy(groupId, householdId, 1)
            && (isPublicGroupData(get(groupPath(groupId)).data) || isConsumingInvitation(groupId, householdId));
        }

        // B-059 : premier membre, coordonnateur, écrit avec le groupe qu'il crée (`isGroupCreation`).
        function isCreatorMembership() {
          let group = getAfter(groupPath(groupId)).data;
          return !exists(groupPath(groupId))
            && request.resource.data.keys().hasOnly(['householdId', 'role', 'joinedAt'])
            && request.resource.data.role == 'coordinator'
            && group.get('createdBy', '') == request.auth.uid
            && group.get('lastMembershipChange', '') == householdId
            && group.get('householdCount', 0) == 1;
        }
        allow update: if false;
        allow delete: if isMemberOfHousehold(householdId)
          && (!exists(groupPath(groupId)) || isCountChangedBy(groupId, householdId, -1));
      }
    }

    // ---------------------------------------------------------------
    // groupInvitations/{code} — invitations à usage unique des groupes privés (B-056)
    // ---------------------------------------------------------------
    // Champs : code (= id du doc, 6 lettres ou chiffres), groupId, createdBy (= créateur du groupe),
    //   createdAt (= request.time), usedBy / usedAt (posés une seule fois en rejoignant), revokedAt.
    // Lecture d'une invitation par son code : tout connecté (celui qui l'a reçue). Liste : le créateur,
    // ses propres invitations seulement (`createdBy == uid` dans la requête).
    // ---------------------------------------------------------------
    match /groupInvitations/{code} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
      allow create: if isAuthenticated()
        && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['code', 'groupId', 'createdBy', 'createdAt'])
        && request.resource.data.code == code
        && request.resource.data.groupId is string
        && isGroupCreator(request.resource.data.groupId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isInvitationRevocation() || isInvitationConsumption();
      allow delete: if false;

      function isUnusedInvitation() {
        return resource.data.get('usedBy', null) == null && resource.data.get('revokedAt', null) == null;
      }

      // Le créateur annule une invitation pas encore utilisée.
      function isInvitationRevocation() {
        return isGroupCreator(resource.data.groupId)
          && isUnusedInvitation()
          && onlyChanges(['revokedAt'])
          && request.resource.data.revokedAt == request.time;
      }

      // Un ménage l'utilise en rejoignant le groupe dans la même transaction (adhésion qui la nomme).
      function isInvitationConsumption() {
        let householdId = request.resource.data.get('usedBy', '');
        let member = memberPath(resource.data.groupId, householdId);
        return isUnusedInvitation()
          && onlyChanges(['usedBy', 'usedAt'])
          && householdId is string && householdId.size() > 0
          && isMemberOfHousehold(householdId)
          && request.resource.data.usedAt == request.time
          && !exists(member)
          && existsAfter(member)
          && getAfter(member).data.get('invitationCode', '') == code;
      }
    }

    // Requête de groupe de collections « groupes d'un ménage » (B-017) : lecture seule,
    // mêmes droits que groups/{id}/members ci-dessus.
    match /{path=**}/members/{householdId} {
      allow read: if isAuthenticated();
    }

    // ---------------------------------------------------------------
    // vendors/{vendorId}
    // ---------------------------------------------------------------

    match /vendors/{vendorId} {
      allow read: if isAuthenticated();
      // T-157 : featuredProductIds = produits mis en avant sur la vitrine (6 au plus).
      allow update: if isVendorOf(vendorId)
        && onlyChanges(['description', 'photoURLs', 'servedZones', 'featuredProductIds'])
        && isShortString(request.resource.data.description, 0, 2000)
        && isStringList(request.resource.data.photoURLs, 10)
        && isStringList(request.resource.data.servedZones, 20)
        && isStringList(request.resource.data.get('featuredProductIds', []), 6);
      // Onboarding producteur (T-158) : un compte connecté crée UN vendeur (id vendor-{uid}) dont il est propriétaire,
      // non vérifié et sans note ; l'équipe LeGrenier le vérifie ensuite (Admin SDK).
      allow create: if isAuthenticated()
        && vendorId == 'vendor-' + request.auth.uid
        && isValidNewVendor(request.resource.data, vendorId);
      allow delete: if false;
    }

    function isValidNewVendor(data, vendorId) {
      return data.keys().hasOnly(['id', 'legalName', 'kind', 'description', 'photoURLs', 'servedZones',
                                  'averageRating', 'isVerified', 'storefrontGeohash', 'ownerId', 'productCategories'])
        && data.keys().hasAll(['id', 'legalName', 'kind', 'description', 'photoURLs', 'servedZones',
                               'isVerified', 'ownerId'])
        && data.id == vendorId
        && data.ownerId == request.auth.uid
        && data.isVerified == false
        && (!('averageRating' in data) || data.averageRating == null)
        && (!('storefrontGeohash' in data) || data.storefrontGeohash == null)
        && isShortString(data.legalName, 2, 120)
        && data.kind in ['farm', 'wholesaler', 'cooperative', 'bakery', 'other']
        && isShortString(data.description, 0, 2000)
        && isStringList(data.photoURLs, 10)
        && isStringList(data.servedZones, 20)
        && (!('productCategories' in data) || data.productCategories == null
            || (isStringList(data.productCategories, 9)
                && data.productCategories.toSet().difference(['grains', 'legumes', 'oils', 'flour', 'canned',
                                                              'eggs', 'meat', 'produce', 'household'].toSet()).size() == 0));
    }

    // ---------------------------------------------------------------
    // vendorReviews/{vendorId}_{householdId} — avis des familles sur un producteur (T-157)
    // ---------------------------------------------------------------
    // Champs : id (= id du doc), vendorId, householdId, authorName (prénom + initiale, 1..60),
    //   rating (int 1..5), comment (string 0..500, optionnel), groupOrderId (commande livrée qui rend éligible),
    //   createdAt, updatedAt (timestamps).
    // Un avis par ménage et par producteur : l'id du doc est `${vendorId}_${householdId}`.
    // Écrit seulement par un membre du ménage auteur, qui a reçu un lot de ce producteur : sa part existe dans
    // une commande livrée (ou cueillie) d'un lot du vendeur. Modifiable (note, commentaire, nom, updatedAt),
    // jamais réattribuable. Lisible par tout connecté (page producteur), supprimable par le ménage auteur.
    // ---------------------------------------------------------------
    function isValidReview(data, reviewId) {
      return data.keys().hasOnly(['id', 'vendorId', 'householdId', 'authorName', 'rating', 'comment',
                                  'groupOrderId', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['id', 'vendorId', 'householdId', 'authorName', 'rating', 'groupOrderId',
                               'createdAt', 'updatedAt'])
        && isShortString(data.vendorId, 1, 128)
        && isShortString(data.householdId, 1, 128)
        && isShortString(data.groupOrderId, 1, 128)
        && data.id == reviewId
        && reviewId == data.vendorId + '_' + data.householdId
        && isShortString(data.authorName, 1, 60)
        && isIntIn(data.rating, 1, 5)
        && isOptionalString(data, 'comment', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Le ménage a reçu un lot de ce vendeur via cette commande.
    function hasReceivedLot(data) {
      let orderPath = /databases/$(database)/documents/groupOrders/$(data.groupOrderId);
      let sharePath = /databases/$(database)/documents/groupOrders/$(data.groupOrderId)/shares/$(data.householdId);
      let order = get(orderPath).data;
      return exists(orderPath) && exists(sharePath)
        && get(/databases/$(database)/documents/offers/$(order.offerId)).data.vendorId == data.vendorId
        && (order.status == 'delivered' || get(sharePath).data.get('isPickedUp', false) == true);
    }

    match /vendorReviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isValidReview(request.resource.data, reviewId)
        && isMemberOfHousehold(request.resource.data.householdId)
        && hasReceivedLot(request.resource.data);
      allow update: if isValidReview(request.resource.data, reviewId)
        && isMemberOfHousehold(resource.data.householdId)
        && onlyChanges(['authorName', 'rating', 'comment', 'updatedAt']);
      allow delete: if isMemberOfHousehold(resource.data.householdId);
    }

    // ---------------------------------------------------------------
    // products/{productId}
    // ---------------------------------------------------------------

    function isValidProduct(data) {
      return data.keys().hasOnly(['id', 'vendorId', 'name', 'category', 'unit', 'origin', 'tags',
                                  'photoURL', 'referenceGroceryPriceCents', 'referencePriceSource'])
        && data.keys().hasAll(['id', 'vendorId', 'name', 'category', 'unit', 'origin', 'tags',
                               'referenceGroceryPriceCents'])
        && isShortString(data.name, 1, 120)
        && data.category in ['grains', 'legumes', 'oils', 'flour', 'canned', 'eggs', 'meat', 'produce', 'household']
        && isShortString(data.unit, 1, 60)
        && isShortString(data.origin, 0, 120)
        && isStringList(data.tags, 20)
        && isOptionalString(data, 'photoURL', 2048)
        && isOptionalString(data, 'referencePriceSource', 500)
        && isIntIn(data.referenceGroceryPriceCents, 0, 10000000);
    }

    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isVendorOf(request.resource.data.vendorId)
        && request.resource.data.id == productId
        && isValidProduct(request.resource.data);
      allow update: if isVendorOf(resource.data.vendorId)
        && areImmutableFieldsUnchanged(['id', 'vendorId'])
        && isValidProduct(request.resource.data);
      allow delete: if isVendorOf(resource.data.vendorId);
    }

    // ---------------------------------------------------------------
    // offers/{offerId}
    // ---------------------------------------------------------------

    // Paliers (OfferLifecycle.validate) : 1 à 10, { minShares, priceCents } entiers, seuils strictement
    // croissants (1..totalShares), prix strictement décroissants (> 0). Les règles des commandes
    // lisent tiers[i] comme `Offer.sortedTiers[i]` : l'ordre trié est donc obligatoire.
    function isValidTier(tiers, i, totalShares) {
      return i >= tiers.size()
        || (tiers[i] is map
          && tiers[i].keys().hasOnly(['minShares', 'priceCents'])
          && tiers[i].keys().hasAll(['minShares', 'priceCents'])
          && isIntIn(tiers[i].minShares, 1, totalShares)
          && isIntIn(tiers[i].priceCents, 1, 10000000)
          && (i == 0 || (tiers[i - 1].minShares < tiers[i].minShares
                         && tiers[i - 1].priceCents > tiers[i].priceCents)));
    }

    function areValidTiers(tiers, totalShares) {
      return tiers is list && tiers.size() >= 1 && tiers.size() <= 10
        && isValidTier(tiers, 0, totalShares) && isValidTier(tiers, 1, totalShares)
        && isValidTier(tiers, 2, totalShares) && isValidTier(tiers, 3, totalShares)
        && isValidTier(tiers, 4, totalShares) && isValidTier(tiers, 5, totalShares)
        && isValidTier(tiers, 6, totalShares) && isValidTier(tiers, 7, totalShares)
        && isValidTier(tiers, 8, totalShares) && isValidTier(tiers, 9, totalShares);
    }

    // B-050 : part structurée (optionnelle, `shareUnit` reste le texte affiché).
    function isValidShare(share) {
      return share is map
        && share.keys().hasOnly(['container', 'count', 'weight', 'valueCents'])
        && share.keys().hasAll(['container', 'count', 'weight'])
        && share.container in ['sac', 'caisse', 'boite', 'palette', 'botte', 'bouteille', 'filet', 'plateau', 'vrac']
        && isIntIn(share.count, 1, 1000)
        && share.weight is map
        && share.weight.keys().hasOnly(['value', 'unit'])
        && share.weight.keys().hasAll(['value', 'unit'])
        && share.weight.value is number && share.weight.value > 0 && share.weight.value <= 1000000
        && share.weight.unit in ['kg', 'g', 'lb', 'L', 'mL', 'unité']
        && (!('valueCents' in share) || isIntIn(share.valueCents, 0, 10000000));
    }

    function isValidOffer(data) {
      let productPath = /databases/$(database)/documents/products/$(data.productId);
      return data.keys().hasOnly(['id', 'vendorId', 'productId', 'totalShares', 'shareUnit', 'share', 'tiers',
                                  'minimumSharesToLaunch', 'deadline', 'zones', 'status'])
        && data.keys().hasAll(['id', 'vendorId', 'productId', 'totalShares', 'shareUnit', 'tiers',
                               'minimumSharesToLaunch', 'deadline', 'zones', 'status'])
        && isIntIn(data.totalShares, 1, 10000)
        && isIntIn(data.minimumSharesToLaunch, 1, data.totalShares)
        && isShortString(data.shareUnit, 1, 60)
        && (!('share' in data) || isValidShare(data.share))
        && areValidTiers(data.tiers, data.totalShares)
        && data.deadline is timestamp
        && isStringList(data.zones, 20)
        && data.status in ['draft', 'active', 'closed', 'cancelled']
        && data.productId is string
        && exists(productPath)
        && get(productPath).data.vendorId == data.vendorId;
    }

    match /offers/{offerId} {
      allow read: if isAuthenticated();
      allow create: if isVendorOf(request.resource.data.vendorId)
        && request.resource.data.id == offerId
        && isValidOffer(request.resource.data);
      // Produit figé (RQ-036) ; une date limite modifiée reste dans le futur : sinon le vendeur
      // pourrait la reculer dans le passé et clôturer les commandes des familles avant l'heure.
      allow update: if isVendorOf(resource.data.vendorId)
        && areImmutableFieldsUnchanged(['id', 'vendorId', 'productId'])
        && isValidOffer(request.resource.data)
        // (1 ms de marge : saveOffer réécrit tout le lot, et l'aller-retour Date ↔ Timestamp peut décaler d'1 µs.)
        && (request.resource.data.deadline > resource.data.deadline - duration.value(1, 'ms')
            || request.resource.data.deadline > request.time);
      // Seulement un brouillon : un lot publié a des commandes qui le relisent (sinon elles restent bloquées).
      allow delete: if isVendorOf(resource.data.vendorId) && resource.data.status == 'draft';
    }

    // Ménage et vendeur de l'utilisateur connecté (users/{uid}.householdId, .vendorId).
    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // users/{uid}.householdId est écrit par l'utilisateur lui-même : on ne le croit que s'il figure
    // vraiment dans households/{id}.userIds (sinon n'importe qui se déclare du ménage d'un autre
    // et modifie ou lit sa part). '' si pas de ménage vérifié.
    function myHouseholdId() {
      let householdId = myUser().get('householdId', '');
      return householdId is string && householdId != '' && isMemberOfHousehold(householdId) ? householdId : '';
    }

    function isGroupMember(groupId) {
      return isAuthenticated() && myHouseholdId() != ''
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(myHouseholdId()));
    }

    function isGroupCoordinator(groupId) {
      return isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.coordinatorIds;
    }

    function isOfferVendor(offer) {
      return isAuthenticated() && myUser().get('vendorId', '') == offer.vendorId;
    }

    function offerOf(order) {
      return get(/databases/$(database)/documents/offers/$(order.offerId)).data;
    }

    function isOpenStatus(status) {
      return status in ['open', 'reached'];
    }

    // ---------------------------------------------------------------
    // groupOrders/{orderId} — commandes groupées (B-019)
    // ---------------------------------------------------------------
    // Champs : id (string, = id du doc, immuable), groupId (string, immuable), offerId (string, immuable),
    //   status ('open'|'reached'|'closed'|'delivered'|'cancelled'), currentTierIndex (int ≥ 0, optionnel),
    //   committedShares (int ≥ 0), committedHouseholds (int ≥ 0), pickupPointId (string, optionnel),
    //   pickupSlots (list).
    // Pas de PII : lisible par tout utilisateur connecté (fil des lots, tableau vendeur).
    // Écrit seulement par le client via FirestoreGroupOrderRepository (transactions) :
    //   - création vide par un membre du groupe, lot actif, avant la date limite ;
    //   - changement de part par un membre : seuls les compteurs, le palier et open/reached bougent,
    //     et l'écart de committedShares est exactement celui de SA part (écrite dans la même transaction) ;
    //   - clôture par le coordonnateur du groupe ou le vendeur du lot, après la date limite.
    // ---------------------------------------------------------------
    function isValidGroupOrder(data, orderId) {
      return data.keys().hasOnly(['id', 'groupId', 'offerId', 'status', 'currentTierIndex',
                                  'committedShares', 'committedHouseholds', 'pickupPointId', 'pickupSlots'])
        && data.keys().hasAll(['id', 'groupId', 'offerId', 'status', 'committedShares',
                               'committedHouseholds', 'pickupSlots'])
        && data.id == orderId
        && data.groupId is string && data.groupId.size() > 0 && data.groupId.size() <= 128
        && data.offerId is string && data.offerId.size() > 0 && data.offerId.size() <= 128
        && data.status in ['open', 'reached', 'closed', 'delivered', 'cancelled']
        && (!('currentTierIndex' in data) || data.currentTierIndex == null
            || (data.currentTierIndex is int && data.currentTierIndex >= 0 && data.currentTierIndex < 10))
        && data.committedShares is int && data.committedShares >= 0 && data.committedShares <= 10000
        && data.committedHouseholds is int && data.committedHouseholds >= 0
        && data.committedHouseholds <= data.committedShares
        && (!('pickupPointId' in data) || data.pickupPointId == null || isShortString(data.pickupPointId, 1, 128))
        && data.pickupSlots is list && data.pickupSlots.size() <= 20;
    }

    // Un champ optionnel n'a pas bougé : le SDK Swift omet un nil (setData) là où le seed écrit null.
    function isSameOptional(after, before, field) {
      return after.get(field, null) == before.get(field, null);
    }

    // `index` est bien le palier atteint avec `committed` parts (`Offer.tierIndex(forCommittedShares:)`),
    // les paliers étant triés (voir areValidTiers) : null sous le premier palier.
    function isTierIndexFor(tiers, committed, index) {
      return (committed < tiers[0].minShares && index == null)
        || (index is int && index >= 0 && index < tiers.size()
            && tiers[index].minShares <= committed
            && (index == tiers.size() - 1 || tiers[index + 1].minShares > committed));
    }

    // Quantité de la part de mon ménage avant / après la requête (0 = pas de part).
    function myShareBefore(orderId) {
      let path = /databases/$(database)/documents/groupOrders/$(orderId)/shares/$(myHouseholdId());
      return exists(path) ? get(path).data.quantity : 0;
    }

    function myShareAfter(orderId) {
      let path = /databases/$(database)/documents/groupOrders/$(orderId)/shares/$(myHouseholdId());
      return existsAfter(path) ? getAfter(path).data.quantity : 0;
    }

    function hasMyShareBefore(orderId) {
      return exists(/databases/$(database)/documents/groupOrders/$(orderId)/shares/$(myHouseholdId()));
    }

    function hasMyShareAfter(orderId) {
      return existsAfter(/databases/$(database)/documents/groupOrders/$(orderId)/shares/$(myHouseholdId()));
    }

    // Changement de part (TierEngine.recalculated) : compteurs, palier et statut recalculés, rien d'autre.
    function isShareCountUpdate(orderId) {
      let before = resource.data;
      let after = request.resource.data;
      let offer = offerOf(before);
      return isGroupMember(before.groupId)
        && request.time < offer.deadline
        && isOpenStatus(before.status) && isOpenStatus(after.status)
        && after.diff(before).affectedKeys()
             .hasOnly(['committedShares', 'committedHouseholds', 'currentTierIndex', 'status', 'pickupPointId'])
        && isSameOptional(after, before, 'pickupPointId')
        && after.committedShares <= offer.totalShares
        && after.status == (after.committedShares >= offer.minimumSharesToLaunch ? 'reached' : 'open')
        && isTierIndexFor(offer.tiers, after.committedShares, after.get('currentTierIndex', null))
        && after.committedShares - before.committedShares == myShareAfter(orderId) - myShareBefore(orderId)
        && after.committedHouseholds - before.committedHouseholds
             == (hasMyShareAfter(orderId) ? 1 : 0) - (hasMyShareBefore(orderId) ? 1 : 0);
    }

    // Clôture (TierEngine.closed) : confirmée au palier atteint si le minimum et le premier palier
    // sont atteints, sinon annulée. Ni les compteurs ni le palier ne se choisissent à la main.
    function isClosingUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let offer = offerOf(before);
      let isConfirmed = before.committedShares >= offer.minimumSharesToLaunch
        && before.committedShares >= offer.tiers[0].minShares;
      return (isGroupCoordinator(before.groupId) || isOfferVendor(offer))
        && request.time >= offer.deadline
        && isOpenStatus(before.status)
        && after.diff(before).affectedKeys().hasOnly(['status', 'currentTierIndex', 'pickupPointId'])
        && isSameOptional(after, before, 'pickupPointId')
        && (isConfirmed
              ? (after.status == 'closed'
                 && isTierIndexFor(offer.tiers, before.committedShares, after.get('currentTierIndex', null)))
              : (after.status == 'cancelled' && isSameOptional(after, before, 'currentTierIndex')));
    }

    // RQ-063 (T-077) : le coordonnateur du groupe choisit le point de cueillette et ses créneaux,
    // tant que la commande n'est ni annulée ni livrée.
    function isPickupChoiceUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return isGroupCoordinator(before.groupId)
        && before.status in ['open', 'reached', 'closed']
        && after.status == before.status
        && after.diff(before).affectedKeys().hasOnly(['pickupPointId', 'pickupSlots'])
        // T-093 : un point qui existe (sinon les familles reçoivent une adresse fantôme).
        && (after.get('pickupPointId', null) == null
            || exists(/databases/$(database)/documents/pickupPoints/$(after.pickupPointId)));
    }

    match /groupOrders/{orderId} {
      allow read: if isAuthenticated();

      allow create: if isValidGroupOrder(request.resource.data, orderId)
        && isGroupMember(request.resource.data.groupId)
        && request.resource.data.status == 'open'
        && request.resource.data.committedShares == 0
        && request.resource.data.committedHouseholds == 0
        && request.resource.data.get('currentTierIndex', null) == null
        && request.resource.data.get('pickupPointId', null) == null
        && request.resource.data.pickupSlots.size() == 0
        && offerOf(request.resource.data).status == 'active'
        && request.time < offerOf(request.resource.data).deadline;

      allow update: if isValidGroupOrder(request.resource.data, orderId)
        && areImmutableFieldsUnchanged(['id', 'groupId', 'offerId'])
        && (isShareCountUpdate(orderId) || isClosingUpdate() || isPickupChoiceUpdate());

      allow delete: if false;

      // -------------------------------------------------------------
      // groupOrders/{orderId}/shares/{householdId} — part d'un ménage
      // -------------------------------------------------------------
      // Champs : householdId (string, = id du doc), quantity (int 1..totalShares),
      //   finalPriceCents (int, optionnel, figé à la clôture), isPaid (bool),
      //   suspendedAmountCents (int 0..20 000, SolidarityLedger.maxSuspendedAmountCents),
      //   subsidyCents (int ≥ 0), qrCode (string, optionnel), isPickedUp (bool), updatedAt (timestamp, optionnel).
      // Lisible par les membres du groupe (la transaction relit toutes les parts) et le vendeur du lot.
      // Un ménage n'écrit que SA part, avant la date limite, commande ouverte, et en mettant à jour
      // la commande dans la même transaction. Prix, subvention et QR : seulement à la clôture, et vérifiés.
      // TODO(E10) : subsidyCents devrait vivre dans un document privé du ménage (aujourd'hui lisible du groupe).
      // -------------------------------------------------------------
      function isValidShare(data, householdId) {
        return data.keys().hasOnly(['householdId', 'quantity', 'finalPriceCents', 'isPaid',
                                    'suspendedAmountCents', 'subsidyCents', 'qrCode', 'isPickedUp', 'updatedAt',
                                    'pickupSlotStart'])
          && data.keys().hasAll(['householdId', 'quantity', 'isPaid', 'suspendedAmountCents',
                                 'subsidyCents', 'isPickedUp'])
          && data.householdId == householdId
          && data.quantity is int && data.quantity >= 1 && data.quantity <= 10000
          && (!('finalPriceCents' in data) || data.finalPriceCents == null
              || (data.finalPriceCents is int && data.finalPriceCents >= 0))
          && data.isPaid is bool
          && data.suspendedAmountCents is int && data.suspendedAmountCents >= 0
          && data.suspendedAmountCents <= 20000
          && data.subsidyCents is int && data.subsidyCents >= 0
          && (!('qrCode' in data) || data.qrCode == null || (data.qrCode is string && data.qrCode.size() <= 200))
          && data.isPickedUp is bool
          && (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp)
          && (!('pickupSlotStart' in data) || data.pickupSlotStart == null || data.pickupSlotStart is timestamp);
      }

      // RQ-064 (T-077) : un ménage choisit ou annule SON créneau, commande ni annulée ni livrée
      // (l'app vérifie que le créneau existe et n'est pas complet) ; le coordonnateur peut seulement effacer une réservation
      // quand il retire un créneau. Rien d'autre ne bouge dans la part.
      function isSlotReservation(householdId) {
        let order = orderDoc();
        let after = request.resource.data;
        return order.status in ['open', 'reached', 'closed']
          && after.diff(resource.data).affectedKeys().hasOnly(['pickupSlotStart'])
          && (
            (householdId == myHouseholdId() && isGroupMember(order.groupId))
            || (isGroupCoordinator(order.groupId) && after.get('pickupSlotStart', null) == null)
          );
      }

      function orderDoc() {
        return get(/databases/$(database)/documents/groupOrders/$(orderId)).data;
      }

      function orderAfter() {
        return getAfter(/databases/$(database)/documents/groupOrders/$(orderId)).data;
      }

      // Ma part, commande ouverte, avant la date limite, compteur de la commande mis à jour avec elle.
      function canChangeMyShare(householdId) {
        let order = orderDoc();
        return householdId == myHouseholdId()
          && isGroupMember(order.groupId)
          && isOpenStatus(order.status)
          && request.time < offerOf(order).deadline
          && orderAfter().committedShares - order.committedShares
               == myShareAfter(orderId) - myShareBefore(orderId);
      }

      // Une famille ne touche ni au prix, ni au paiement, ni au QR, ni à la cueillette.
      function isFamilyShape(data) {
        return data.get('finalPriceCents', null) == null
          && data.isPaid == false
          && data.subsidyCents == 0
          && data.get('qrCode', null) == null
          && data.isPickedUp == false;
      }

      // Ménage subventionné (statut privé posé avec un code d'organisme, RQ-082).
      function isSubsidizedHousehold(householdId) {
        let profile = get(/databases/$(database)/documents/households/$(householdId)/private/profile).data;
        return profile.get('isSubsidized', false) == true
          && profile.get('referralCode', '').matches('ORG-[A-Z]{2}-[0-9]{4}[0-9X]');
      }

      // Clôture (ShareAllocator.allocate) : prix = quantité × prix du palier figé, subvention au plus le prix
      // et seulement pour un ménage subventionné, QR de cette commande et de ce ménage.
      function isClosingAllocation(data, householdId) {
        let order = orderAfter();
        let unitPriceCents = offerOf(order).tiers[order.currentTierIndex].priceCents;
        return data.get('finalPriceCents', null) == data.quantity * unitPriceCents
          && data.subsidyCents is int && data.subsidyCents >= 0
          && data.subsidyCents <= data.finalPriceCents
          && (data.get('updatedAt', null) == null || data.updatedAt is timestamp)
          && (data.subsidyCents == 0 || isSubsidizedHousehold(householdId))
          && data.get('qrCode', null) is string
          && data.qrCode.matches('GRENIER:[^:]+:[^:]+:[0-9a-f]{8}')
          && data.qrCode.split(':')[1] == orderId
          && data.qrCode.split(':')[2] == householdId;
      }

      match /shares/{householdId} {
        allow read: if isAuthenticated()
          && (isGroupMember(orderDoc().groupId) || isOfferVendor(offerOf(orderDoc())));

        allow create: if isValidShare(request.resource.data, householdId)
          && isFamilyShape(request.resource.data)
          && canChangeMyShare(householdId);

        // Le ménage : quantité et panier suspendu. Le reste ne bouge pas (une subvention déjà posée par
        // le seed reste telle quelle, un null du seed peut devenir absent).
        // Clôture en premier, et sans isValidShare : seuls prix, subvention, QR (et updatedAt) bougent, vérifiés
        // un par un. Les règles ont un budget de 1000 expressions pour TOUTE la transaction de clôture :
        // revalider chaque part en entier le dépassait vers 20 ménages (test « grosse commande »).
        allow update: if (orderAfter().status == 'closed'
            && isOpenStatus(orderDoc().status)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['finalPriceCents', 'subsidyCents', 'qrCode', 'updatedAt'])
            && (isGroupCoordinator(orderDoc().groupId) || isOfferVendor(offerOf(orderDoc())))
            && isClosingAllocation(request.resource.data, householdId))
          || (isValidShare(request.resource.data, householdId)
            && (
              // Le ménage : quantité et panier suspendu. Le reste ne bouge pas (une subvention déjà posée par
              // le seed reste telle quelle, un null du seed peut devenir absent).
              (request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['quantity', 'suspendedAmountCents', 'updatedAt', 'finalPriceCents', 'qrCode'])
                && isSameOptional(request.resource.data, resource.data, 'finalPriceCents')
                && isSameOptional(request.resource.data, resource.data, 'qrCode')
                && canChangeMyShare(householdId))
              || isSlotReservation(householdId)
            ));

        allow delete: if canChangeMyShare(householdId);
      }
    }

    // ---------------------------------------------------------------
    // pickupPoints/{pickupPointId}
    // ---------------------------------------------------------------

    match /pickupPoints/{pickupPointId} {
      allow read: if isAuthenticated();
      // RQ-062 (T-077) : un utilisateur devient hôte en créant SON point (hostUserId = lui),
      // puis le modifie (nom, adresse, photo, capacité, accessibilité, créneaux).
      function isValidPickupPoint(data) {
        return data.keys().hasOnly(['id', 'hostUserId', 'name', 'address', 'photoURL', 'capacity',
                                    'accessibility', 'slots',
                                    // Champs posés par le seed (T-144) : un point seedé reste modifiable par son hôte.
                                    'groupId', 'neighborhood', 'latitude', 'longitude', 'geohash'])
          && data.keys().hasAll(['id', 'hostUserId', 'name', 'address', 'capacity', 'accessibility', 'slots'])
          && data.id == pickupPointId
          && data.hostUserId == request.auth.uid
          && data.name is string && data.name.size() > 0 && data.name.size() <= 80
          && data.address is string && data.address.size() > 0 && data.address.size() <= 200
          && data.slots is list && data.slots.size() <= 50
          && isIntIn(data.capacity, 1, 1000)
          && isStringList(data.accessibility, 10)
          && isOptionalString(data, 'photoURL', 2048)
          && isOptionalString(data, 'groupId', 128)
          && isOptionalString(data, 'neighborhood', 60)
          && isOptionalString(data, 'geohash', 12)
          && (!('latitude' in data) || data.latitude == null
              || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
          && (!('longitude' in data) || data.longitude == null
              || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180));
      }

      allow create: if isAuthenticated() && isValidPickupPoint(request.resource.data);
      allow update: if isAuthenticated()
        && resource.data.hostUserId == request.auth.uid
        && isValidPickupPoint(request.resource.data)
        // Le groupe et le quartier d'un point ne changent pas (rattachement fait au seed ou à la création).
        && areImmutableFieldsUnchanged(['groupId', 'neighborhood']);
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // groups/{groupId}/wishes/{wishId} — envies des familles (S-07)
    // ---------------------------------------------------------------
    // Champs : id (= id du doc), groupId (= groupe du chemin), householdId (ménage de l'auteur, immuable),
    //   category, productId (optionnel), quantity (nombre > 0), unit, frequency,
    //   wantedFrom / wantedUntil (timestamps optionnels), createdAt (immuable), updatedAt.
    // Un membre du groupe écrit les envies de SON ménage seulement. Lecture : membres du groupe (l'agrégat
    // anonyme se calcule côté client, sans Cloud Functions) et comptes vendeurs (Matcher). Les fiches des
    // ménages restent illisibles de l'extérieur : un householdId n'apprend rien sur la famille.
    // ---------------------------------------------------------------
    function isAnyVendor() {
      return isAuthenticated() && myUser().get('vendorId', '') != '';
    }

    function isOptionalTimestamp(data, field) {
      return !(field in data) || data[field] == null || data[field] is timestamp;
    }

    function isValidWish(data, groupId, wishId) {
      return data.keys().hasOnly(['id', 'groupId', 'householdId', 'category', 'productId', 'quantity', 'unit',
                                  'frequency', 'wantedFrom', 'wantedUntil', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['id', 'groupId', 'householdId', 'category', 'quantity', 'unit', 'frequency',
                               'createdAt', 'updatedAt'])
        && data.id == wishId
        && data.groupId == groupId
        && isShortString(data.householdId, 1, 128)
        && data.category in ['grains', 'legumes', 'oils', 'flour', 'canned', 'eggs', 'meat', 'produce', 'household']
        && isOptionalString(data, 'productId', 128)
        && data.quantity is number && data.quantity > 0 && data.quantity <= 10000
        && data.unit in ['kg', 'l', 'dozen', 'unit']
        && data.frequency in ['once', 'weekly', 'biweekly', 'monthly']
        && isOptionalTimestamp(data, 'wantedFrom')
        && isOptionalTimestamp(data, 'wantedUntil')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /groups/{groupId}/wishes/{wishId} {
      allow read: if isGroupMember(groupId) || isAnyVendor();
      allow create: if isValidWish(request.resource.data, groupId, wishId)
        && isGroupMember(groupId)
        && request.resource.data.householdId == myHouseholdId();
      allow update: if isValidWish(request.resource.data, groupId, wishId)
        && isGroupMember(groupId)
        && resource.data.householdId == myHouseholdId()
        && areImmutableFieldsUnchanged(['id', 'groupId', 'householdId', 'createdAt']);
      // Un ménage qui a quitté le groupe peut encore retirer ses envies.
      allow delete: if isAuthenticated() && resource.data.householdId == myHouseholdId();
    }

    // Requête collectionGroup('wishes') : envies de tous les groupes, pour les vendeurs.
    match /{path=**}/wishes/{wishId} {
      allow read: if isAnyVendor();
    }

    // ---------------------------------------------------------------
    // vendors/{vendorId}/supplies/{supplyId} — disponibilités des vendeurs (S-08)
    // ---------------------------------------------------------------
    // Champs : id (= id du doc), vendorId (= vendeur du chemin), category, productId (optionnel, produit
    //   de ce vendeur), quantity (nombre > 0), unit, availableFrom <= availableTo (timestamps),
    //   servedZones (1 à 20 préfixes geohash), createdAt (immuable), updatedAt.
    // Pas de PII : lisible par tout utilisateur connecté ; écrite par le vendeur propriétaire seulement.
    // ---------------------------------------------------------------
    function isValidSupply(data, vendorId, supplyId) {
      return data.keys().hasOnly(['id', 'vendorId', 'category', 'productId', 'quantity', 'unit',
                                  'availableFrom', 'availableTo', 'servedZones', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['id', 'vendorId', 'category', 'quantity', 'unit', 'availableFrom',
                               'availableTo', 'servedZones', 'createdAt', 'updatedAt'])
        && data.id == supplyId
        && data.vendorId == vendorId
        && data.category in ['grains', 'legumes', 'oils', 'flour', 'canned', 'eggs', 'meat', 'produce', 'household']
        && (!('productId' in data) || data.productId == null
            || (isShortString(data.productId, 1, 128)
                && get(/databases/$(database)/documents/products/$(data.productId)).data.vendorId == vendorId))
        && data.quantity is number && data.quantity > 0 && data.quantity <= 1000000
        && data.unit in ['kg', 'l', 'dozen', 'unit']
        && data.availableFrom is timestamp
        && data.availableTo is timestamp
        && data.availableFrom <= data.availableTo
        && data.servedZones is list && data.servedZones.size() >= 1 && data.servedZones.size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /vendors/{vendorId}/supplies/{supplyId} {
      allow read: if isAuthenticated();
      allow create: if isVendorOf(vendorId)
        && isValidSupply(request.resource.data, vendorId, supplyId);
      allow update: if isVendorOf(vendorId)
        && isValidSupply(request.resource.data, vendorId, supplyId)
        && areImmutableFieldsUnchanged(['id', 'vendorId', 'createdAt']);
      allow delete: if isVendorOf(vendorId);
    }

    // Requête collectionGroup('supplies') : disponibilités de tous les vendeurs, pour le Matcher.
    match /{path=**}/supplies/{supplyId} {
      allow read: if isAuthenticated();
    }

    // ---------------------------------------------------------------
    // Images en bytes Firestore (T-132, Q-033) : pas de Cloud Storage sur le forfait Spark.
    // ---------------------------------------------------------------
    // users/{uid}/media/avatar                  avatar ; écrit et supprimé par son propriétaire
    // groups/{groupId}/media/{photo | banner}   photo et bannière ; écrites et supprimées par un coordonnateur
    // vendors/{vendorId}/media/photo-{id}       photos de vitrine ; écrites et supprimées par le vendeur (T-157)
    // Champs : data (bytes JPEG compressé par l'app, 300 Kio au plus ; un document Firestore est limité
    //   à 1 Mio), contentType == 'image/jpeg', width et height (entiers 1..4096), updatedAt == request.time.
    // Lecture : tout utilisateur connecté (une image de profil ou de groupe n'est pas de la PII sensible ;
    //   la fiche users/{uid} reste privée). Chaque affichage coûte une lecture : l'app garde un cache
    //   invalidé par users.photoUpdatedAt / groups.photoUpdatedAt / groups.bannerUpdatedAt.
    // ---------------------------------------------------------------
    function isValidMedia(data) {
      return data.keys().hasOnly(['data', 'contentType', 'width', 'height', 'updatedAt'])
        && data.keys().hasAll(['data', 'contentType', 'width', 'height', 'updatedAt'])
        && data.data is bytes
        && data.data.size() > 0
        && data.data.size() <= 300 * 1024
        && data.contentType == 'image/jpeg'
        && isIntIn(data.width, 1, 4096)
        && isIntIn(data.height, 1, 4096)
        && data.updatedAt == request.time;
    }

    match /users/{userId}/media/{mediaId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId)
        && mediaId == 'avatar'
        && isValidMedia(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // T-157 : photos de vitrine du vendeur (`photo-<id>`, 10 au plus côté app) ; écrites par le vendeur seulement.
    match /vendors/{vendorId}/media/{mediaId} {
      allow read: if isAuthenticated();
      allow create, update: if isVendorOf(vendorId)
        && mediaId.matches('photo-[A-Za-z0-9-]{1,64}')
        && isValidMedia(request.resource.data);
      allow delete: if isVendorOf(vendorId);
    }

    match /groups/{groupId}/media/{mediaId} {
      allow read: if isAuthenticated();
      allow create, update: if isGroupCoordinator(groupId)
        && mediaId in ['photo', 'banner']
        && isValidMedia(request.resource.data);
      allow delete: if isGroupCoordinator(groupId);
    }

    // ---------------------------------------------------------------
    // boroughStats/{boroughId} — agrégats par arrondissement (RQ-093, T-114)
    // ---------------------------------------------------------------
    // Totaux seulement (ménages, paniers offerts, familles aidées, économies), aucune donnée personnelle.
    // Lecture : tout utilisateur connecté (le classement est calculé côté client). Écriture : jamais
    // depuis l'app ; le seed ou un script d'administration (Admin SDK) remplit la collection.
    // ---------------------------------------------------------------
    match /boroughStats/{boroughId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Tout le reste : refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
