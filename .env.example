# Copie ce fichier en .env (ignoré par git) et remplis les valeurs.
# Les valeurs viennent de : npx -y firebase-tools@latest apps:sdkconfig IOS <FIREBASE_IOS_APP_ID> --project <FIREBASE_PROJECT_ID>
# Ensuite : scripts/firebase/generate-plist.sh  (écrit AMC-MobileApp/GoogleService-Info.plist)
FIREBASE_PROJECT_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_BUNDLE_ID=
FIREBASE_API_KEY=
FIREBASE_GCM_SENDER_ID=
FIREBASE_GOOGLE_APP_ID=
FIREBASE_CLIENT_ID=
FIREBASE_REVERSED_CLIENT_ID=
FIREBASE_STORAGE_BUCKET=
