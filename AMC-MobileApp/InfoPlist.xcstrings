    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "LeGrenier utilise la caméra pour lire le code QR d'une famille quand tu lui remets sa part. Aucune image n'est enregistrée."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LeGrenier uses Face ID to protect your account and confirm your payments."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LeGrenier utilise Face ID pour protéger ton compte et confirmer tes paiements."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LeGrenier uses your location while the map is open to show groups, pickup points and producers near you. It is never shared with your neighbours."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LeGrenier utilise ta position pendant que la carte est ouverte pour te montrer les groupes, les points de cueillette et les producteurs près de chez toi. Elle n'est jamais partagée avec tes voisins."
          }
        }
      }
    }
  },
  "version" : "1.0"
