<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Fusionné avec l'Info.plist généré par Xcode (GENERATE_INFOPLIST_FILE = YES). -->
	<!-- Nom affiché sous l'icône. -->
	<key>CFBundleDisplayName</key>
	<string>Grenier</string>
	<!-- Schéma d'URL de retour Google Sign-In = REVERSED_CLIENT_ID de GoogleService-Info.plist. -->
	<!-- Face ID : verrou de l'app et confirmation des paiements (Core/Security). -->
	<key>NSFaceIDUsageDescription</key>
	<string>Grenier utilise Face ID pour protéger ton compte et confirmer tes paiements.</string>
	<!-- Live Activity de la commande (cible GrenierWidgets, Core/LiveActivity), démarrée localement. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>google-sign-in</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.959550736484-74nu238bfp7b7lfsj19tqccnmptpek7v</string>
			</array>
		</dict>
	</array>
	<!-- Nom affiché sous l'icône et dans la feuille système « … veut utiliser accounts.google.com » (sinon « AMC-MobileApp »). -->
	<key>CFBundleDisplayName</key>
	<string>Grenier</string>
	<!-- Bouton « Se connecter avec Apple » (RQ-012). false si l'App ID n'a pas la capability Sign in with Apple. -->
	<key>GRNSignInWithAppleEnabled</key>
	<true/>
	<!-- Rafraîchissement en arrière-plan → notifications locales, sans serveur (T-107, Core/Notifications/BackgroundRefresh). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>ca.amc2026.mobileapp.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
