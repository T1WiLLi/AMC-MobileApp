rules_version = '2';

// Règles Storage de Grenier — prototype de la compétition. Tests : scripts/rules-tests.
// - vendors/{vendorId}/... : photos de produits et de vitrine, écrites par le vendeur rattaché
//   (users/{uid}.vendorId, posé par le seed ou un admin), lues par les utilisateurs connectés.
// - users/{uid}/... : photo de profil, écrite par son propriétaire.
// Images (JPEG, PNG, HEIC, WebP, GIF ; pas de SVG) seulement, 5 Mo maximum. Tout le reste est refusé.
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        // Formats matriciels seulement : un SVG (image/svg+xml) peut contenir du script, servi tel quel
        // depuis le domaine du bucket (XSS stockée) — T-093.
        && request.resource.contentType.matches('image/(jpeg|png|heic|heif|webp|gif)');
    }

    function isVendorOf(vendorId) {
      let userPath = /databases/(default)/documents/users/$(request.auth.uid);
      return isAuthenticated()
        && firestore.exists(userPath)
        && firestore.get(userPath).data.get('vendorId', '') == vendorId;
    }

    match /vendors/{vendorId}/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if isVendorOf(vendorId) && isImageUnder5MB();
      allow delete: if isVendorOf(vendorId);
    }

    match /users/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId && isImageUnder5MB();
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
