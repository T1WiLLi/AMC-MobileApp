{
  "sourceLanguage": "fr",
  "strings": {
    "Changer d'adresse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use another address"
          }
        }
      }
    },
    "Courriel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Email"
          }
        }
      }
    },
    "Créer un compte": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create account"
          }
        }
      }
    },
    "C’est reparti ! Regarde aussi dans tes courriels indésirables.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent again! Check your spam folder too."
          }
        }
      }
    },
    "J'ai vérifié mon courriel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've verified my email"
          }
        }
      }
    },
    "Mot de passe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password"
          }
        }
      }
    },
    "Mot de passe oublié ?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forgot password?"
          }
        }
      }
    },
    "On t'a envoyé un lien à %@. Touche-le pour activer ton compte, puis reviens ici.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We sent a link to %@. Tap it to activate your account, then come back here."
          }
        }
      }
    },
    "Ouvrir Mail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Mail"
          }
        }
      }
    },
    "Pas encore vérifié. Touche le lien dans le courriel, puis reviens ici.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not verified yet. Tap the link in the email, then come back here."
          }
        }
      }
    },
    "Possible dans %lld secondes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available in %lld seconds"
          }
        }
      }
    },
    "Prénom": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First name"
          }
        }
      }
    },
    "Renvoyer dans %lld s": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resend in %lld s"
          }
        }
      }
    },
    "Renvoyer le courriel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resend email"
          }
        }
      }
    },
    "Se connecter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in"
          }
        }
      }
    },
    "Te déconnecte pour utiliser un autre courriel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs you out to use another email"
          }
        }
      }
    },
    "Vérifie ton courriel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your email"
          }
        }
      }
    },
    "ou": {
      "localizations": {
        "en": {
          "stringUnit": {
