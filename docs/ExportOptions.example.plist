<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Options d'export pour xcodebuild -exportArchive (voir docs/ipa-build.md).
  Copier vers build-export.plist (non commité) et remplacer TEAM_ID_ICI.
  method :
    debugging       = signature développement (ex-"development"), appareils enregistrés de l'équipe
    release-testing = ad hoc (ex-"ad-hoc"), compte payant, rôle Admin / Account Holder
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>debugging</string>
	<key>teamID</key>
	<string>TEAM_ID_ICI</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>compileBitcode</key>
	<false/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>thinning</key>
	<string>&lt;none&gt;</string>
</dict>
</plist>
