      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, your family"
          }
        }
      }
    },
    "- %@ (%@) : %@, %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
